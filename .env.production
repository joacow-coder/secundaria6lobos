# Variables VITE_* que el bundle del NAVEGADOR necesita en tiempo de build.
#
# Por qué existe este archivo: Cloudflare Workers Builds no expone las `vars`
# de wrangler.jsonc como variables de entorno del proceso durante `bun run
# build` — esas `vars` solo quedan disponibles en RUNTIME, dentro del propio
# Worker (vía `env`/`process.env` gracias a nodejs_compat). Vite en cambio
# reemplaza `import.meta.env.VITE_*` por su valor literal en tiempo de build,
# leyendo `.env`/`.env.production` del repo — no el runtime del Worker.
#
# Sin este archivo, `import.meta.env.VITE_SUPABASE_URL` (y el resto de las
# VITE_*) quedan `undefined` en TODO el código que corre en el navegador, y
# cualquier llamada a Supabase hecha directamente desde el cliente (sin pasar
# por un createServerFn/loader del servidor) explota con "Missing Supabase
# environment variable(s)". Esto rompía la navegación SPA de vuelta a "/" (el
# loader de esa ruta corre en el navegador en una transición cliente) y las
# queries de la Biblioteca Digital (useQuery + supabase.from() directo).
#
# Los valores de acá son los mismos, texto plano, que ya están committeados
# en wrangler.jsonc → "vars": son claves públicas/publishable pensadas para
# viajar al navegador, no secretos (ver nota en wrangler.jsonc). Si se rotan,
# hay que actualizar los dos lugares.
VITE_SUPABASE_URL="https://owmxbcsverzskddcaczx.supabase.co"
VITE_SUPABASE_PROJECT_ID="owmxbcsverzskddcaczx"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_8liswFvZ03oiCJxFda4ONg_8eY_xz1Q"

VITE_FUTURO_SUPABASE_URL="https://etztcmivbufdjnuarzwd.supabase.co"
VITE_FUTURO_SUPABASE_PUBLISHABLE_KEY="sb_publishable_8liswFvZ03oiCJxFda4ONg_8eY_xz1Q"

VITE_VAPID_PUBLIC_KEY="BFsZb6E5S-u-ddgjJCztCFH6BAIpWNxMnExUXqy7WInylxItIVHJtmY1nzaVX8vImxlqgvXEj5s5iUU01yRB13w"
