{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secundaria-6-lobos",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true
	},
	// Variables públicas: no son secretas (la clave "publishable"/anon de
	// Supabase está pensada para exponerse — la RLS es lo que protege los
	// datos, y las VITE_* ya viajan igual dentro del bundle del navegador).
	// Las secretas (service role, códigos de acceso, API keys) NO van acá:
	// se configuran con `wrangler secret put` — ver README/instrucciones.
	"vars": {
		"VITE_SUPABASE_URL": "https://owmxbcsverzskddcaczx.supabase.co",
		"VITE_SUPABASE_PROJECT_ID": "owmxbcsverzskddcaczx",
		"VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8liswFvZ03oiCJxFda4ONg_8eY_xz1Q",
		"SUPABASE_URL": "https://owmxbcsverzskddcaczx.supabase.co",
		"SUPABASE_PROJECT_ID": "owmxbcsverzskddcaczx",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8liswFvZ03oiCJxFda4ONg_8eY_xz1Q",
		"VITE_FUTURO_SUPABASE_URL": "https://etztcmivbufdjnuarzwd.supabase.co",
		"VITE_FUTURO_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8liswFvZ03oiCJxFda4ONg_8eY_xz1Q"
	}
}
