# Supabase (cliente / navegador)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase (servidor)
SUPABASE_URL=""
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
# Requerida por src/integrations/supabase/auth-middleware.ts (rol de servicio, NO exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=""

# El mapa (src/components/LeafletMap.tsx) usa Leaflet.js + tiles de
# OpenStreetMap: no necesita ninguna clave ni variable de entorno.

# Backend separado de "Tu Futuro" (src/lib/futuro/client.ts) — proyecto Supabase
# distinto al de la escuela. Si se deja vacío, usa el proyecto compartido actual
# como valor por defecto (ver el fallback en el código).
VITE_FUTURO_SUPABASE_URL=""
VITE_FUTURO_SUPABASE_PUBLISHABLE_KEY=""

# Asistente de IA (src/lib/biblioteca/assistant.functions.ts y src/lib/site.functions.ts).
# Llama directo a la API de Gemini (generativelanguage.googleapis.com), por su
# endpoint OpenAI-compatible — sin pasar por ningún gateway de terceros.
# Conseguí la clave en Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Códigos de acceso del personal (src/lib/biblioteca/messages.functions.ts)
TEACHER_MASTER_CODE=""
PRECEPTOR_MASTER_CODE=""
DIRECTOR_MASTER_CODE=""

# Código de acceso al panel de administración del sitio (src/lib/site.functions.ts).
# Sin esto configurado, /admin queda deshabilitado (no hay valor por defecto).
SITE_ADMIN_MASTER_CODE=""

# Notificaciones push (src/lib/push.functions.ts). Generar el par de claves con
# `npx web-push generate-vapid-keys`. La pública no es secreta (viaja al cliente
# como VITE_*); la privada NUNCA se versiona ni se comparte.
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Mail institucional de contacto, formato "mailto:direccion@ees6lobos.edu.ar"
VAPID_SUBJECT=""
