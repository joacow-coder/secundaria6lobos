# Supabase (cliente / navegador)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase (servidor)
SUPABASE_URL=""
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
# Rol de servicio (NO exponer al cliente). Se usa solo acá en local dev: en
# producción viene de Cloudflare Secrets Store (ver "secrets_store_secrets" en
# wrangler.jsonc y src/lib/secrets.server.ts) — NO de "Variables and Secrets"
# del dashboard ni de `wrangler secret put`, que Cloudflare Workers Builds
# borra en cada deploy automático (bug conocido, sin fix aún:
# github.com/cloudflare/workers-sdk/issues/8871).
SUPABASE_SERVICE_ROLE_KEY=""

# El mapa (src/components/LeafletMap.tsx) usa Leaflet.js + tiles de
# OpenStreetMap: no necesita ninguna clave ni variable de entorno.

# Backend separado de "Tu Futuro" (src/lib/futuro/client.ts) — proyecto Supabase
# distinto al de la escuela. Si se deja vacío, usa el proyecto compartido actual
# como valor por defecto (ver el fallback en el código).
VITE_FUTURO_SUPABASE_URL=""
VITE_FUTURO_SUPABASE_PUBLISHABLE_KEY=""

# El asistente "Lobi" (src/lib/biblioteca/assistant.functions.ts y
# src/lib/site.functions.ts) busca por palabras clave en la tabla Supabase
# site_faq y en las materias/materiales/noticias reales — no usa IA ni
# ninguna clave de API externa. Los contenidos de la FAQ se editan con SQL
# directo sobre esa tabla (ver supabase/migrations).

# Códigos de acceso del personal (src/lib/biblioteca/messages.functions.ts).
# En producción también vienen de Cloudflare Secrets Store, igual que
# SUPABASE_SERVICE_ROLE_KEY — ver nota arriba.
TEACHER_MASTER_CODE=""
PRECEPTOR_MASTER_CODE=""
DIRECTOR_MASTER_CODE=""

# Código de acceso al panel de administración del sitio (src/lib/site.functions.ts).
# Sin esto configurado, /admin queda deshabilitado. En producción viene de
# Secrets Store, igual que los de arriba.
SITE_ADMIN_MASTER_CODE=""

# Notificaciones push (src/lib/push.functions.ts). Generar el par de claves con
# `npx web-push generate-vapid-keys`. La pública no es secreta (viaja al cliente
# como VITE_*, va como var normal en wrangler.jsonc); la privada NUNCA se
# versiona ni se comparte — en producción viene de Secrets Store.
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Mail institucional de contacto, formato "mailto:direccion@ees6lobos.edu.ar"
VAPID_SUBJECT=""
